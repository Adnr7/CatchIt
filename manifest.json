{
  "manifest_version": 3,
  "name": "CatchIt — AI Safe Browsing",
  "version": "1.0.0",
  "description": "AI-powered browser extension that protects you from phishing, scams, and malicious websites in real time.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ai-analyzer.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-safe-16.png",
      "48": "icons/icon-safe-48.png",
      "128": "icons/icon-safe-128.png"
    },
    "default_title": "CatchIt — AI Safe Browsing"
  },
  "icons": {
    "16": "icons/icon-safe-16.png",
    "48": "icons/icon-safe-48.png",
    "128": "icons/icon-safe-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}